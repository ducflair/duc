{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONTRIBUTING.md"
  ],
  "commands": {
    "gen-commit-message": {
      "template": "Generate the commit message for the staged changes (if no staged changes fallback to checking the unstaged changes) using the /commit-messages skill. On the response, print only the message as a code block with the proposed commit message",
      "description": "Generate commit message for the code changes"
    }
  },
  "permissions": [
    { "action": "shell", "resource": "cargo check*", "effect": "allow" },
    { "action": "shell", "resource": "cargo build*", "effect": "allow" },
    { "action": "shell", "resource": "cargo test*", "effect": "allow" },

    { "action": "shell", "resource": "bun ducpdf:test*", "effect": "allow" },
    { "action": "shell", "resource": "bun ducpdf:build*", "effect": "allow" },
    { "action": "shell", "resource": "bun ducjs:build*", "effect": "allow" },
    { "action": "shell", "resource": "bun ducrs:build*", "effect": "allow" },
    { "action": "shell", "resource": "bun ducpy:test*", "effect": "allow" },
    { "action": "shell", "resource": "bun test*", "effect": "allow" },

    { "action": "shell", "resource": "git *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },

    { "action": "shell", "resource": "sst*", "effect": "deny" },
    { "action": "shell", "resource": "bun run sst:*", "effect": "deny" },
    { "action": "shell", "resource": "bun sst:*", "effect": "deny" },
    { "action": "shell", "resource": "npx sst:*", "effect": "deny" },
    { "action": "shell", "resource": "bunx sst:*", "effect": "deny" }
  ]
}